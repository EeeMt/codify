--- w2/pkg/src/runs/background/top-level-async.ts	2026-09-12 19:52:24.505969693 +0800
+++ w/pkg/src/runs/background/top-level-async.ts	2026-09-12 19:52:24.762902260 +0800
@@ -12,3 +12,18 @@
 	if (params.foregroundOnly || !(depth === 0 && forceTopLevelAsync)) return params;
 	return { ...params, async: true, clarify: false };
 }
+
+// Codify vendor patch (open-harness-v2-subagent-adaptation.md §6.4).
+//
+// The parent Harness only sees a child's identity, usage and final output in
+// the launch's structured result, and an async/detached launch returns an empty
+// child inventory. The ceiling therefore pins depth-0 launches to the
+// foreground path; the model can no longer opt into background work.
+export function applyForceTopLevelForegroundOverride<T extends AsyncOverrideParams>(
+	params: T,
+	depth: number,
+	forceTopLevelForeground: boolean,
+): T {
+	if (!(depth === 0 && forceTopLevelForeground)) return params;
+	return { ...params, async: false };
+}
