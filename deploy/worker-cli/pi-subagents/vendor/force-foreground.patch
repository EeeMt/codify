 	return { ...params, async: true, clarify: false };
 }
+
+// Codify vendor patch (open-harness-v2-subagent-adaptation.md §6.4).
+//
+// Two documented behaviours are pinned for a depth-0 launch:
+//
+// - `async: false`. WorkflowScript calls use background execution whenever the
+//   request omits `async` (docs/configuration.md, `asyncByDefault`), and a
+//   detached launch returns no child inventory, so the parent stream would lose
+//   every child's identity, usage and output. `asyncByDefault: false` does not
+//   cover workflowScript; the documented per-call escape is `async: false`.
+// - `agentScope: "user"`. Agenth scope defaults to `both`, which reads agent
+//   definitions, project settings and package-provided agents out of the
+//   cloned workspace (docs/agents.md). Scope is a launch parameter that
+//   propagates to workflow children, so pinning it here keeps the ceiling's
+//   four bundled agents the only ones a Codify Task can launch.
+export function applyCodifyCeilingOverrides<T extends AsyncOverrideParams>(
+	params: T,
+	depth: number,
+	ceilingActive: boolean,
+): T {
+	if (!(depth === 0 && ceilingActive)) return params;
+	return { ...params, async: false, agentScope: "user" };
+}
