+// Codify vendor patch: `agentScope: "user"` (pinned by the ceiling, see
+// top-level-async.ts) keeps project and package *definitions* out of every
+// launch, but it does not cover project *settings*: those still supply
+// defaultModel/defaultProvider/defaultThinking/defaultExtensions, rewrite or
+// disable bundled agents through `agentOverrides`, and can re-enable the
+// plugin's builtins with `disableBuiltins: false`. All of them are read through
+// this one path, so the ceiling hides the workspace settings file entirely and
+// only Codify's own task-local Pi home settings apply
+// (open-harness-v2-subagent-adaptation.md §6.4).
+function codifyWorkspaceSettingsHidden(): boolean {
+	return process.env.CODIFY_PI_SUBAGENT_ISOLATED === "1";
+}
+
 function getProjectAgentSettingsPath(cwd: string): string | null {
+	if (codifyWorkspaceSettingsHidden()) return null;
 	const projectRoot = findConfiguredProjectRoot(cwd);
 	return projectRoot ? path.join(getProjectConfigDir(projectRoot), "settings.json") : null;
 }
