# Codify 功能地图
# d2 frontend/src/guide/assets/feature-map.d2 frontend/src/guide/assets/feature-map.svg --pad 24 --theme 0 --layout dagre

vars: {
  d2-config: {
    layout-engine: dagre
  }
}

classes: {
  box: {
    style.opacity: 1
    style.stroke-width: 1
    style.font-size: 13
    style.border-radius: 6
  }
}

# ================================================================
# 纯纵向树 - 6 行 × 向右展开
# ================================================================

# 行 1: 核心引擎
engine: "🧠 核心引擎" {
  style.fill: "#E3F2FD"; style.stroke: "#1E88E5"; style.font-color: "#0D47A1"
  style.stroke-width: 2; style.font-size: 16; style.bold: true
  turns: "任务生命周期 · Issue 有序回合\n\n创建 — usage quota 校验 · 分配 Issue 序号 turn #n · 冻结 Task Snapshot · 绑定 Runtime Bundle\n排队 — 只把每个已解锁 Issue 的到期队首升为 QUEUED\n认领 — 单事务：Issue 锁 + 序号校验 + CAS QUEUED→RUNNING\n执行 — Docker 隔离 · 加载冻结 Bundle · 启动 Harness · Canonical Event 恰好一次摄取\n交付 — commit/push 到 Issue 分支 · 创建或更新 MR · 代码统计 · Token 用量\n终止 — COMPLETED / FAILED / CANCELLED · 释放 Issue 锁 · 调度器崩溃恢复" {
    class: box
    style.fill: "#BBDEFB"; style.stroke: "#1E88E5"; style.font-color: "#0D47A1"
  }
  harness: "多 Harness 执行 · capability policy\n\nharness_key — claude · codex · opencode · pi（编译期白名单）\n线协议 — anthropic-messages / openai-responses · Provider 按协议自动匹配\ncapability policy — 系统上限写死在代码，Profile 只能收紧、不能放宽\n能力位 — resume · task_skills · usage_tokens · steering · follow_up · subagents\n适配器 — 版本与 digest 冻进 Runtime Bundle，无 Bundle 证据不得声明\ncodex / opencode 不支持 max_turns 与 CodeGraph，改按墙钟超时" {
    class: box
    style.fill: "#BBDEFB"; style.stroke: "#1E88E5"; style.font-color: "#0D47A1"
  }
  steer: "Live steering 实时引导\n\nSteer — 运行中插入指令 · Follow-up — 后续引导\n命令信封 — steer / follow_up · 幂等 command id\n控制门 — Starting → Accepting → Draining → Closed\n命令状态 — Queued · Dispatching · Delivered · Rejected · Outcome unknown\n门控 — 按冻结 Bundle 的能力位判定，历史任务无法事后升级\n语义 — Harness accepted 只表示接口收下，不保证模型已消费" {
    class: box
    style.fill: "#BBDEFB"; style.stroke: "#1E88E5"; style.font-color: "#0D47A1"
  }
  sched: "调度 · Issue 互斥 · Slot 容量\n\n优先级 P0 > P1 > P2 · 计划时间 · 全局并发上限\nP0-P2 与定时只在 Issue 之间仲裁，绝不重排同一 Issue 的回合\nPer-issue mutex — 同一 Issue 串行执行，防并发冲突\nSlot 容量 — 每小时窗口上限 · 超限仅警告或直接阻断创建\n调度热力图预览 · 管理员改期 · execute 与 plan 两种任务模式" {
    class: box
    style.fill: "#BBDEFB"; style.stroke: "#1E88E5"; style.font-color: "#0D47A1"
  }
  issue: "Issue 管理\n\nCRUD · 分支自动命名 · base / target branch\n状态 OPEN → CLOSED · 关闭即删分支 · MR 合并自动关闭 · 409 防误删\n默认 AI Provider · Worker Profile · Harness · CI 自动修复开关\n同一 Issue 共享工作区、会话与分支，后续回合接着上次继续" {
    class: box
    style.fill: "#BBDEFB"; style.stroke: "#1E88E5"; style.font-color: "#0D47A1"
  }
}

# 行 2: 数据洞察
data: "📊 数据与洞察" {
  style.fill: "#E8F5E9"; style.stroke: "#43A047"; style.font-color: "#1B5E20"
  style.stroke-width: 2; style.font-size: 16; style.bold: true
  process: "过程日志与事件\n\n结构化 — thinking / tool_call / assistant_text / system_init · Payload 懒加载\nCanonical Event — event.jsonl · 控制事件行 · 容器轮询 + SSE 推送\n原始日志 — TaskRawLogChunk 分块 · ANSI 与 emoji · 超长截断并提示\n工具调用入参/出参归档 · Thinking 占位生命周期" {
    class: box
    style.fill: "#C8E6C9"; style.stroke: "#43A047"; style.font-color: "#1B5E20"
  }
  delivery: "交付物与 Run Archive\n\n交付摘要 — Markdown + Mermaid SVG · 缩放弹窗 · 拖拽平移\nRun Archive — console.log · repository-preparation.json · event.jsonl · runtime.json\n归档保留天数可配 · 过期文件不再可下载，但任务与 Issue 不删\nTaskContinuationPanel 后续引导入口 · 代码统计与 MR 链接" {
    class: box
    style.fill: "#C8E6C9"; style.stroke: "#43A047"; style.font-color: "#1B5E20"
  }
  stats: "统计分析\n\nDashboard · Activity 热力图 · MyWorkBoard\nAnalytics 7 / 30 / 90 天 · Provider 对比 · 失败归因\n调度热力图 · Slot 容量占用 · 执行时长与排队压力" {
    class: box
    style.fill: "#C8E6C9"; style.stroke: "#43A047"; style.font-color: "#1B5E20"
  }
  monitor: "系统监控\n\n队列压力 · Worker 与容器对齐 · 失败率\n容器列表与探针 · Kanban 看板 · 序列修复告警" {
    class: box
    style.fill: "#C8E6C9"; style.stroke: "#43A047"; style.font-color: "#1B5E20"
  }
  lifecycle: "生命周期统计\n\nSystem Statistics — 保留数据 + 删除路径归档\n覆盖起点之后才计入 · 已删任务只显示净化快照，无详情链接\n维护性数据清理不破坏历史统计" {
    class: box
    style.fill: "#C8E6C9"; style.stroke: "#43A047"; style.font-color: "#1B5E20"
  }
}

# 行 3: 配置中心
config: "⚙️ 配置中心" {
  style.fill: "#FFF3E0"; style.stroke: "#FB8C00"; style.font-color: "#E65100"
  style.stroke-width: 2; style.font-size: 16; style.bold: true
  profile: "Worker Profile → Task Snapshot → Runtime Bundle\n\n共享配置继承 — overlay / mask / per-key merge + revision\n镜像 · 挂载 · 环境变量 · 前后置脚本 · 运行指令模板 · 默认 Skills\nHarness 选择与约束收紧（max_turns / sandbox / network / timeout）· CodeGraph 开关\n任务创建时解析为不可变 Task Snapshot，并绑定 sha256 Runtime Bundle\n重试复用冻结 Bundle — 运行中的任务底下不会变" {
    class: box
    style.fill: "#FFE0B2"; style.stroke: "#FB8C00"; style.font-color: "#E65100"
  }
  skills: "Skills 目录与 MCP\n\n全局 Skills 目录（zip 上传）— SKILL.md frontmatter 校验 · 不可变版本\n启用 / 禁用 · 每任务 ≤20 个 · 单包 ≤8 MiB · 单任务 ≤32 MiB\nProfile 默认 Skills · 任务级覆盖 · 版本冻进快照并可提示漂移\nCodeGraph MCP server 与项目索引 · MCP 扩展\n要求 mounted-kit ≥ 0.3.5，烘焙镜像模式已弃用" {
    class: box
    style.fill: "#FFE0B2"; style.stroke: "#FB8C00"; style.font-color: "#E65100"
  }
  provider: "AI Provider\n\nCRUD · 默认项 · 启用 / 禁用 · 协议校验\nbase_url / model / max_turns · 高级请求参数随快照冻结\n凭据轮换与退役 · 执行快照与当前配置分开显示" {
    class: box
    style.fill: "#FFE0B2"; style.stroke: "#FB8C00"; style.font-color: "#E65100"
  }
  runtime: "运行时与调度参数\n\n并发 · 任务超时 · 重试延迟 · Slot 容量与强制开关\nWorker Volume · 全局环境变量 · 公告栏 · Worker Kit 就绪校验\nFernet 加密存储 · 单 key / 全量重置 · 运行时覆盖免重启" {
    class: box
    style.fill: "#FFE0B2"; style.stroke: "#FB8C00"; style.font-color: "#E65100"
  }
  template: "提示词与运行指令模板\n\n提示词模板 — CRUD · tags · sort_order · 标签筛选选择器\n运行指令模板 — Implementation / Plan · 实时预览\n创建任务时快照进 Task Snapshot" {
    class: box
    style.fill: "#FFE0B2"; style.stroke: "#FB8C00"; style.font-color: "#E65100"
  }
  catalog: "Harness 目录\n\nmanifest 投影 — 用户面唯一的能力输入，不外泄适配器路径\n可用性 present / unavailable · 版本探测 · 未验证\nProfile 与任务表单据此过滤可选 Harness" {
    class: box
    style.fill: "#FFE0B2"; style.stroke: "#FB8C00"; style.font-color: "#E65100"
  }
}

# 行 4: 协作集成
collab: "🔔 协作与集成" {
  style.fill: "#F3E5F5"; style.stroke: "#8E24AA"; style.font-color: "#4A148C"
  style.stroke-width: 2; style.font-size: 16; style.bold: true
  gitlab: "GitLab 集成\n\nURL / Bot Token / Admin Token（加密不回显）· 连接测试\n项目与分支 · Webhook 管理与事件日志 · Secret 校验\nMR 自动创建/更新 · Draft · Codify 标签 · 以请求者身份提交\nMR 合并 → Issue 自动关闭" {
    class: box
    style.fill: "#E1BEE7"; style.stroke: "#8E24AA"; style.font-color: "#4A148C"
  }
  ci: "CI 失败自动修复\n\nWebhook 接收 · Pipeline 识别 · 证据收集\n根因分析 → 自动创建修复任务 · 并发锁防重复\n按 Issue / 项目开关 · 每个 MR 的最大修复次数（0 = 关闭）\nCI 证据包随工作区保留期清理" {
    class: box
    style.fill: "#E1BEE7"; style.stroke: "#8E24AA"; style.font-color: "#4A148C"
  }
  mattermost: "Mattermost 通知\n\nChannel / DM · @mention · 事件订阅\n用户自动映射 · 投递追踪 · Bot Token 加密存储" {
    class: box
    style.fill: "#E1BEE7"; style.stroke: "#8E24AA"; style.font-color: "#4A148C"
  }
  webhooks: "Webhook 事件日志\n\nGitLab 事件入库 · 事件查看面板\nSecret 校验 · 失败排查与定位" {
    class: box
    style.fill: "#E1BEE7"; style.stroke: "#8E24AA"; style.font-color: "#4A148C"
  }
}

# 行 5: 平台治理
govern: "🛡️ 平台治理" {
  style.fill: "#FFEBEE"; style.stroke: "#E53935"; style.font-color: "#B71C1C"
  style.stroke-width: 2; style.font-size: 16; style.bold: true
  users: "身份与访问\n\nGitLab OIDC — issuer / client / redirect · 登录与回调\nOIDC Diagnostics 诊断页 · 可对非管理员开放\n本地账号 + 密码 · Break-glass 登录 · 会话管理 · Bootstrap" {
    class: box
    style.fill: "#FFCDD2"; style.stroke: "#E53935"; style.font-color: "#B71C1C"
  }
  quota: "Usage quota 用量配额\n\n四个维度 — 日/周 Token · 日/周 任务\n三种模式 — 继承 / 覆盖 / 无限制\n任务粒度记账 · 创建时校验 · 双关口阻断 · 管理员编辑" {
    class: box
    style.fill: "#FFCDD2"; style.stroke: "#E53935"; style.font-color: "#B71C1C"
  }
  access: "访问管理\n\n用户列表 · 角色 platform_admin / platform_user\n配额覆盖 · 启用禁用 · 用量超限标记" {
    class: box
    style.fill: "#FFCDD2"; style.stroke: "#E53935"; style.font-color: "#B71C1C"
  }
  ops: "系统运维\n\n维护性数据清理 · Alembic 迁移 · Prompt 回填\n/health 探针 · Trace-ID 全链路 · 500 异常处理 · 告警 webhook" {
    class: box
    style.fill: "#FFCDD2"; style.stroke: "#E53935"; style.font-color: "#B71C1C"
  }
}

# 行 6: 前端设施
fe: "🎨 前端基础设施" {
  style.fill: "#E0F2F1"; style.stroke: "#00897B"; style.font-color: "#004D40"
  style.stroke-width: 2; style.font-size: 16; style.bold: true
  i18n: "国际化与 UI\n\nzh-CN / en 双语键同步 · Naive UI 组件库\n响应式断点 · 语言切换 · 应用内指南双语文档" {
    class: box
    style.fill: "#B2DFDB"; style.stroke: "#00897B"; style.font-color: "#004D40"
  }
  comp: "组件库\n\nPageHeader · FilterToolbar · HeatmapChart · StatCard\nTaskFormDrawer · TaskProcessPanel · TaskSteeringPanel\nTaskResultPanel · TaskRuntimeSummaryRows · 配置面板群" {
    class: box
    style.fill: "#B2DFDB"; style.stroke: "#00897B"; style.font-color: "#004D40"
  }
  api: "API 与逻辑\n\nAxios 统一实例（base /api，401 跳登录）\nTrace-ID 透传 · Composables · 工具函数 · 类型定义" {
    class: box
    style.fill: "#B2DFDB"; style.stroke: "#00897B"; style.font-color: "#004D40"
  }
  guide: "应用内指南\n\n章节 markdown 构建期内联进 SPA · /guide 页\n中英双语文档（guide/zh-CN、guide/en）\nassets 图片按 URL 解析 · Mermaid 水合渲染" {
    class: box
    style.fill: "#B2DFDB"; style.stroke: "#00897B"; style.font-color: "#004D40"
  }
}

# 连接: 引擎 → 数据
engine.turns -> data.process: "产出日志与事件" { style.stroke-dash: 3; style.stroke: "#90A4AE" }

# 连接: 引擎 → 通知
engine.turns -> collab.mattermost: "触发通知" { style.stroke-dash: 3; style.stroke: "#90A4AE" }

# 连接: 引擎 → 配置中心
engine.turns -> config.profile: "冻结快照" { style.stroke-dash: 3; style.stroke: "#90A4AE" }
engine.turns -> config.runtime: "读取运行时配置" { style.stroke-dash: 3; style.stroke: "#90A4AE" }

# 强制纵向堆叠
engine -> data { style.opacity: 0 }
data -> config { style.opacity: 0 }
config -> collab { style.opacity: 0 }
collab -> govern { style.opacity: 0 }
govern -> fe { style.opacity: 0 }
