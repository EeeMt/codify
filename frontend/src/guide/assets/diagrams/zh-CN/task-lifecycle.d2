# 章节：40-run-and-steer（运行与引导）· 任务生命周期
# 读者要理解：任务在六个状态之间的移动路径——什么时候排队、什么时候开始执行、
# 哪些状态可以取消，以及终态可以人工修正。
# 渲染：python3 scripts/guide/render-diagrams.py（在仓库根目录执行）

vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: right

classes: {
  node: {
    style.fill: "#FFFFFF"
    style.stroke: "#334155"
    style.stroke-width: 1
    style.font-color: "#0F172A"
    style.font-size: 14
    style.border-radius: 8
  }
  accent: {
    style.fill: "#EFF6FF"
    style.stroke: "#1D4ED8"
    style.font-color: "#0F172A"
    style.font-size: 14
    style.border-radius: 8
  }
  external: {
    style.fill: "#F8FAFC"
    style.stroke: "#94A3B8"
    style.stroke-dash: 4
    style.font-color: "#0F172A"
    style.font-size: 14
    style.border-radius: 8
  }
}

states: {
  label: ""
  grid-rows: 2
  grid-columns: 3
  grid-gap: 90
  style.fill: transparent
  style.stroke-width: 0

  pending: "待处理\n等待执行" { class: node }
  queued: "已入队\n等待空闲并发" { class: node }
  running: "执行中\n容器正在执行" { class: accent }
  completed: "已完成\n执行结束" { class: node }
  failed: "失败\n错误或超时" { class: node }
  cancelled: "已取消\n由你停止" { class: node }

  # 运行态的三种结局已经写在目标状态上，因此这三条边不带标签：待处理 / 已入队
  # 到已取消的两条长斜线会穿过这条带，标签会正好压住连线。两个终态之间的手动
  # 修正只画一个方向——失败 -> 已完成。
  pending -> queued
  queued -> running: "开始执行"
  running -> completed
  running -> failed
  running -> cancelled
  pending -> cancelled
  queued -> cancelled
  failed -> completed: "手动修正"
}
