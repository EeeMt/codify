# 章节：60-scheduling（调度）· 任务为什么还没开始
# 读者要理解：任务迟迟不运行只有三种原因——不是所属 Issue 的队首、
# 预约时间还没到、并发容量已满。
# 渲染：python3 scripts/guide/render-diagrams.py（在仓库根目录执行）

vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: right

classes: {
  node: {
    style.fill: "#FFFFFF"
    style.stroke: "#334155"
    style.stroke-width: 1
    style.font-color: "#0F172A"
    style.font-size: 14
    style.border-radius: 8
  }
  accent: {
    style.fill: "#EFF6FF"
    style.stroke: "#1D4ED8"
    style.font-color: "#0F172A"
    style.font-size: 14
    style.border-radius: 8
  }
  external: {
    style.fill: "#F8FAFC"
    style.stroke: "#94A3B8"
    style.stroke-dash: 4
    style.font-color: "#0F172A"
    style.font-size: 14
    style.border-radius: 8
  }
}

chain: {
  label: ""
  grid-rows: 2
  grid-columns: 4
  grid-gap: 45
  style.fill: transparent
  style.stroke-width: 0

  ready: "任务就绪\n等待调度" { class: node }
  head: "是所属 Issue\n的队首吗?" { class: node }
  due: "预约时间\n到了吗?" { class: node }
  capacity: "有空闲并发\n吗?" { class: node }
  below_gap: " " { style.fill: transparent; style.stroke-width: 0 }
  waiting_issue: "排队等待\n前序未结束" { class: node }
  waiting_slot: "等待调度\n按优先级排序" { class: node }
  start: "开始执行\n占用并发" { class: accent }

  ready -> head
  head -> due: "是"
  head -> waiting_issue: "否"
  due -> capacity: "已到"
  due -> waiting_slot: "未到"
  capacity -> start: "空位"
  capacity -> waiting_slot: "已满"
}
