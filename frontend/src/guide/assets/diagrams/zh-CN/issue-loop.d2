# 章节：10-quick-start（快速开始）· 一个需求，多个回合
# 读者要理解：需求只创建一次，它拥有工作区、AI 会话与分支；之后是在同一个
# 需求上反复追加回合——创建或追加 Task、在隔离容器里执行、评审结果，再决定
# 是否继续，满意后合并这唯一一个合并请求，需求随之关闭。
# 渲染：python3 scripts/guide/render-diagrams.py（在仓库根目录执行）

vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: right

classes: {
  node: {
    style.fill: "#FFFFFF"
    style.stroke: "#334155"
    style.stroke-width: 1
    style.font-color: "#0F172A"
    style.font-size: 14
    style.border-radius: 8
  }
  accent: {
    style.fill: "#EFF6FF"
    style.stroke: "#1D4ED8"
    style.font-color: "#0F172A"
    style.font-size: 14
    style.border-radius: 8
  }
  external: {
    style.fill: "#F8FAFC"
    style.stroke: "#94A3B8"
    style.stroke-dash: 4
    style.font-color: "#0F172A"
    style.font-size: 14
    style.border-radius: 8
  }
}

# 三行三列让画布接近指南图框的宽度，14px 的标签被缩小得很少。两个透明占位节点把
# 下两行的第一列留空，于是「继续下一回合」正好落在「创建 / 追加任务」下方，回环
# 箭头是一条短竖线，收尾的一对节点共用最后一行。
loop: {
  label: ""
  grid-rows: 3
  grid-columns: 3
  grid-gap: 48
  style.fill: transparent
  style.stroke-width: 0

  # 判断词写在分支卡片里，不放在箭头上：箭头保持干净，标签也不会压在卡片边框上。
  create_issue: "需求只创建一次\n工作区、会话、分支" { class: accent }
  append_task: "创建或追加 Task\n开始下一回合" { class: node }
  run_turn: "回合执行\n隔离容器中运行" { class: node }
  gap_a: " " { style.fill: transparent; style.stroke-width: 0 }
  continue_turn: "继续下一回合\n追加 Task" { class: accent }
  review: "评审结果\n继续下一回合或合入" { class: node }
  gap_b: " " { style.fill: transparent; style.stroke-width: 0 }
  merge_mr: "结果满意后合入\n唯一 Merge Request" { class: node }
  close_issue: "需求关闭\nMR 已合并" { class: node }

  create_issue -> append_task
  append_task -> run_turn
  run_turn -> review
  review -> continue_turn
  continue_turn -> append_task
  review -> merge_mr
  merge_mr -> close_issue
}
