# 章节：10-quick-start（快速开始）· 一个需求，多个回合
# 读者要理解：需求只创建一次，它拥有工作区、AI 会话与分支；之后是在同一个
# 需求上反复追加回合——创建或追加 Task、执行、评审，再决定是否继续，
# 满意后合并这唯一一个合并请求，需求随之关闭。
# 渲染：python3 scripts/guide/render-diagrams.py（在仓库根目录执行）

vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: right

classes: {
  node: {
    style.fill: "#FFFFFF"
    style.stroke: "#334155"
    style.stroke-width: 1
    style.font-color: "#0F172A"
    style.font-size: 14
    style.border-radius: 8
  }
  accent: {
    style.fill: "#EFF6FF"
    style.stroke: "#1D4ED8"
    style.font-color: "#0F172A"
    style.font-size: 14
    style.border-radius: 8
  }
  external: {
    style.fill: "#F8FAFC"
    style.stroke: "#94A3B8"
    style.stroke-dash: 4
    style.font-color: "#0F172A"
    style.font-size: 14
    style.border-radius: 8
  }
}

loop: {
  label: ""
  grid-rows: 3
  grid-columns: 4
  grid-gap: 48
  style.fill: transparent
  style.stroke-width: 0

  # The decision words live inside the branch cards instead of on edges. This
  # keeps the arrows clear and prevents labels from sitting on card borders.
  create_issue: "创建需求\n一次创建，拥有工作区 · 分支" { class: accent }
  append_task: "创建 / 追加任务\n共享同一份上下文" { class: node }
  run_turn: "回合执行\n隔离容器中运行" { class: node }
  review: "评审结果\n决定下一步" { class: node }
  gap_a: " " { style.fill: transparent; style.stroke-width: 0 }
  continue_turn: "继续下一回合\n追加 Task" { class: accent }
  gap_b: " " { style.fill: transparent; style.stroke-width: 0 }
  merge_mr: "结果满意后合入\n唯一 Merge Request" { class: node }
  gap_c: " " { style.fill: transparent; style.stroke-width: 0 }
  gap_d: " " { style.fill: transparent; style.stroke-width: 0 }
  gap_e: " " { style.fill: transparent; style.stroke-width: 0 }
  close_issue: "需求关闭\n完成这一条需求" { class: node }

  create_issue -> append_task
  append_task -> run_turn
  run_turn -> review
  review -> continue_turn
  continue_turn -> append_task
  review -> merge_mr
  merge_mr -> close_issue
}
