# 章节：90-troubleshooting（故障排查）· 任务失败后的排查顺序
# 读者要理解：先看错误卡片，再顺着事件流、原始日志、运行归档逐层深入；
# 错误卡片里的失败信息有几种常见形态——超时、配额、运行时不可用、推送未确认。
# 渲染：python3 scripts/guide/render-diagrams.py（在仓库根目录执行）

vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: right

classes: {
  node: {
    style.fill: "#FFFFFF"
    style.stroke: "#334155"
    style.stroke-width: 1
    style.font-color: "#0F172A"
    style.font-size: 14
    style.border-radius: 8
  }
  accent: {
    style.fill: "#EFF6FF"
    style.stroke: "#1D4ED8"
    style.font-color: "#0F172A"
    style.font-size: 14
    style.border-radius: 8
  }
  external: {
    style.fill: "#F8FAFC"
    style.stroke: "#94A3B8"
    style.stroke-dash: 4
    style.font-color: "#0F172A"
    style.font-size: 14
    style.border-radius: 8
  }
}

triage: {
  label: ""
  grid-rows: 2
  grid-columns: 4
  grid-gap: 30
  style.fill: transparent
  style.stroke-width: 0

  timeout: "超时\n本次超时上限偏小" { class: node }
  error: "1. 失败原因\n错误卡片" { class: accent }
  events: "2. 事件流\n按发生顺序记录" { class: node }
  logs: "3. 原始日志\n容器原始输出" { class: node }
  quota: "配额超限\n执行前被拦截" { class: node }
  runtime: "Worker 运行时\n不可用" { class: node }
  push: "推送未确认\n交付不算完成" { class: node }
  archive: "4. 运行归档\n完整证据" { class: node }

  error -> events
  events -> logs
  logs -> archive
  error -> timeout
  error -> quota
  error -> runtime
  error -> push
}
