# 章节：30-create-task（创建任务）· 任务模式与执行时机
# 读者要理解：创建任务时要从两组里各选一个——任务模式决定 Harness 是否改代码，
# 执行时机决定任务什么时候进入调度队列。
# 渲染：python3 scripts/guide/render-diagrams.py（在仓库根目录执行）

vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: right

classes: {
  node: {
    style.fill: "#FFFFFF"
    style.stroke: "#334155"
    style.stroke-width: 1
    style.font-color: "#0F172A"
    style.font-size: 14
    style.border-radius: 8
  }
  accent: {
    style.fill: "#EFF6FF"
    style.stroke: "#1D4ED8"
    style.font-color: "#0F172A"
    style.font-size: 14
    style.border-radius: 8
  }
  external: {
    style.fill: "#F8FAFC"
    style.stroke: "#94A3B8"
    style.stroke-dash: 4
    style.font-color: "#0F172A"
    style.font-size: 14
    style.border-radius: 8
  }
}

choice: {
  label: ""
  grid-rows: 3
  grid-columns: 3
  grid-gap: 40
  style.fill: transparent
  style.stroke-width: 0

  execute: "实施模式\n改代码并提交" { class: node }
  blank_a: " " { style.fill: transparent; style.stroke-width: 0 }
  now: "立即执行\n创建后进入队列" { class: node }
  plan: "分析模式\n只输出方案，不改文件" { class: node }
  task: "Task\n模式与时机各选一个" { class: accent }
  blank_b: " " { style.fill: transparent; style.stroke-width: 0 }
  freeform: "自由模式\n模型自行判断" { class: node }
  blank_c: " " { style.fill: transparent; style.stroke-width: 0 }
  at: "定时执行\n指定未来的时间点" { class: node }

  execute -> task
  plan -> task
  freeform -> task
  now -> task
  at -> task
}
