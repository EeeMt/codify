# 章节：30-create-task（创建任务）· 任务模式与执行时机
# 读者要理解：创建任务时要从两组里各选一个——任务模式决定 Harness 是否改代码，
# 执行时机决定任务什么时候进入调度队列。
# 渲染：python3 scripts/guide/render-diagrams.py（在仓库根目录执行）

vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: right

classes: {
  node: {
    style.fill: "#F7F9FC"
    style.stroke: "#294A6E"
    style.stroke-width: 1
    style.font-color: "#102A43"
    style.font-size: 14
    style.border-radius: 14
  }
  accent: {
    style.fill: "#E8F0FF"
    style.stroke: "#2454A6"
    style.stroke-width: 2
    style.font-color: "#102A43"
    style.font-size: 14
    style.border-radius: 14
  }
  choice: {
    style.fill: "#FFF3D6"
    style.stroke: "#B7791F"
    style.stroke-width: 2
    style.font-color: "#5F370E"
    style.font-size: 14
    style.border-radius: 14
  }
  evidence: {
    style.fill: "#E6F7F2"
    style.stroke: "#187A6F"
    style.stroke-width: 2
    style.font-color: "#123B36"
    style.font-size: 14
    style.border-radius: 14
  }
  external: {
    style.fill: "#F7F9FC"
    style.stroke: "#8EA0B5"
    style.stroke-dash: 4
    style.font-color: "#334E68"
    style.font-size: 14
    style.border-radius: 14
  }
}

# 两组各占一片：左边是任务模式簇（模式节点加三个选项，逐行绕在它周围，每个选项
# 都紧挨着自己的父节点），右边是调度簇，带两个时机选项。
choice: {
  label: ""
  grid-rows: 2
  grid-columns: 4
  grid-gap: 32
  style.fill: transparent
  style.stroke-width: 0

  mode: "任务模式\n决定运行方式" { class: accent }
  impl: "实施模式\n改代码并提交" { class: node }
  sched: "调度\n决定何时排队" { class: node }
  now: "立即执行\n创建后进入队列" { class: node }
  analysis: "分析模式\n只输出方案" { class: evidence }
  freeform: "自由模式\n模型自行判断" { class: choice }
  at: "定时执行\n指定未来的时间点" { class: node }
  gap: " " { style.fill: transparent; style.stroke-width: 0 }

  mode -> impl
  mode -> analysis
  mode -> freeform
  sched -> now
  sched -> at
}
