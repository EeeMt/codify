# 章节：10-quick-start（快速开始）· 三步循环
# 读者要理解：Codify 的主流程只有三步——写需求、发起任务、查看结果；
# 任务结束后可以在同一工作区、会话与分支上「追加任务」继续推进。

vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: right

classes: {
  node: {
    style.fill: "#FFFFFF"
    style.stroke: "#334155"
    style.stroke-width: 1
    style.font-color: "#0F172A"
    style.font-size: 14
    style.border-radius: 8
  }
  accent: {
    style.fill: "#EFF6FF"
    style.stroke: "#1D4ED8"
    style.font-color: "#0F172A"
    style.font-size: 14
    style.border-radius: 8
  }
  external: {
    style.fill: "#F8FAFC"
    style.stroke: "#94A3B8"
    style.stroke-dash: 4
    style.font-color: "#0F172A"
    style.font-size: 14
    style.border-radius: 8
  }
}

loop: {
  label: ""
  grid-rows: 2
  grid-columns: 4
  grid-gap: 45
  style.fill: transparent
  style.stroke-width: 0

  write_issue: "写需求\nIssue" { class: accent }
  create_task: "发起任务\nTask" { class: node }
  wait_run: "等待执行\n排队 · 调度" { class: node }
  see_result: "查看结果\ncommit + MR" { class: node }
  below_gap: " " { style.fill: transparent; style.stroke-width: 0 }
  append_task: "追加任务\n共享工作区 · 会话 · 分支" { class: node }

  write_issue -> create_task
  create_task -> wait_run
  wait_run -> see_result
  create_task -> append_task
}
