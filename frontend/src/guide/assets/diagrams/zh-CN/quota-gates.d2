# 章节：85-admin-governance（治理与运维）· 配额在哪里拦人
# 读者要理解：配额只统计四项——日 / 周 Token 与日 / 周任务数；创建任务时超限
# 直接被拒绝，开始执行前再校验一次，超限的任务直接失败。
# 渲染：python3 scripts/guide/render-diagrams.py（在仓库根目录执行）

vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: right

classes: {
  node: {
    style.fill: "#FFFFFF"
    style.stroke: "#334155"
    style.stroke-width: 1
    style.font-color: "#0F172A"
    style.font-size: 14
    style.border-radius: 8
  }
  accent: {
    style.fill: "#EFF6FF"
    style.stroke: "#1D4ED8"
    style.font-color: "#0F172A"
    style.font-size: 14
    style.border-radius: 8
  }
  external: {
    style.fill: "#F8FAFC"
    style.stroke: "#94A3B8"
    style.stroke-dash: 4
    style.font-color: "#0F172A"
    style.font-size: 14
    style.border-radius: 8
  }
}

gates: {
  label: ""
  grid-rows: 3
  grid-columns: 4
  grid-gap: 40
  style.fill: transparent
  style.stroke-width: 0

  daily_tokens: "日 Token\n当天" { class: node }
  weekly_tokens: "周 Token\n当周" { class: node }
  daily_tasks: "日任务数\n当天" { class: node }
  gap1: " " { style.fill: transparent; style.stroke-width: 0 }
  weekly_tasks: "周任务数\n当周" { class: node }
  created: "创建任务\n第一道检查" { class: accent }
  queued: "任务入队\n等待并发容量" { class: node }
  start: "开始执行前\n第二道检查" { class: accent }
  gap2: " " { style.fill: transparent; style.stroke-width: 0 }
  rejected: "请求被拒绝\n任务不会写入" { class: node }
  gap3: " " { style.fill: transparent; style.stroke-width: 0 }
  failed: "任务失败\n未做任何工作" { class: node }

  daily_tokens -> created
  weekly_tokens -> created
  daily_tasks -> created
  weekly_tasks -> created
  created -> queued
  queued -> start
  created -> rejected: "超限"
  start -> failed: "超限"
}
