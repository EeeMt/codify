# 章节：70-observability（可观测性）· 五个页面各回答什么问题
# 读者要理解：仪表盘看自己的进度、统计分析看窗口内的趋势与成本、监控看正在发生
# 的故障、调度总览看未来负载、会话管的是控制台登录会话。
# 渲染：python3 scripts/guide/render-diagrams.py（在仓库根目录执行）

vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: right

classes: {
  node: {
    style.fill: "#FFFFFF"
    style.stroke: "#334155"
    style.stroke-width: 1
    style.font-color: "#0F172A"
    style.font-size: 14
    style.border-radius: 8
  }
  accent: {
    style.fill: "#EFF6FF"
    style.stroke: "#1D4ED8"
    style.font-color: "#0F172A"
    style.font-size: 14
    style.border-radius: 8
  }
  external: {
    style.fill: "#F8FAFC"
    style.stroke: "#94A3B8"
    style.stroke-dash: 4
    style.font-color: "#0F172A"
    style.font-size: 14
    style.border-radius: 8
  }
}

pages: {
  label: ""
  grid-rows: 2
  grid-columns: 3
  grid-gap: 45
  style.fill: transparent
  style.stroke-width: 0

  dashboard: "仪表盘\n自己的进度" { class: node }
  analytics: "统计分析\n趋势与成本" { class: node }
  monitor: "监控\n正在发生的故障" { class: node }
  schedule: "调度总览\n未来负载" { class: node }
  q: "我想知道什么\n对应哪个页面" { class: accent }
  sessions: "会话\n控制台登录会话" { class: node }

  q -> dashboard
  q -> analytics
  q -> monitor
  q -> schedule
  q -> sessions
}
