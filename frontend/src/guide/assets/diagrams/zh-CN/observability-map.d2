# 章节：70-observability（可观测性）· 五个页面各回答什么问题
# 读者要理解：仪表盘看我的任务与趋势、统计分析看窗口内的成败与成本、监控看
# 实时执行与容器排障、调度总览看未来忙闲、会话管的是控制台登录会话。
# 渲染：python3 scripts/guide/render-diagrams.py（在仓库根目录执行）

vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: right

classes: {
  node: {
    style.fill: "#FFFFFF"
    style.stroke: "#334155"
    style.stroke-width: 1
    style.font-color: "#0F172A"
    style.font-size: 14
    style.border-radius: 8
  }
  accent: {
    style.fill: "#EFF6FF"
    style.stroke: "#1D4ED8"
    style.font-color: "#0F172A"
    style.font-size: 14
    style.border-radius: 8
  }
  external: {
    style.fill: "#F8FAFC"
    style.stroke: "#94A3B8"
    style.stroke-dash: 4
    style.font-color: "#0F172A"
    style.font-size: 14
    style.border-radius: 8
  }
}

pages: {
  label: ""
  grid-rows: 2
  grid-columns: 3
  grid-gap: 45
  style.fill: transparent
  style.stroke-width: 0

  dashboard: "仪表盘\n我的任务与趋势" { class: node }
  analytics: "统计分析\n成功率与趋势对比" { class: node }
  monitor: "监控\n实时执行与容器排障" { class: node }
  schedule: "调度总览\n未来什么时候忙" { class: node }
  console: "控制台\n五个页面各回答一问" { class: accent }
  sessions: "会话\n控制台登录会话" { class: node }

  console -> dashboard
  console -> analytics
  console -> monitor
  console -> schedule
  console -> sessions
}
