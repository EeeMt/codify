# 章节：80-admin-configuration（系统配置）· Worker Profile
# 读者要理解：管理员编辑 Worker Profile，任务创建时冻结成 Task Snapshot，
# 执行时按冻结身份解析出 Runtime Bundle；之后修改 Worker Profile 不影响已创建的任务。
# 渲染：python3 scripts/guide/render-diagrams.py（在仓库根目录执行）

vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: right

classes: {
  node: {
    style.fill: "#FFFFFF"
    style.stroke: "#334155"
    style.stroke-width: 1
    style.font-color: "#0F172A"
    style.font-size: 14
    style.border-radius: 8
  }
  accent: {
    style.fill: "#EFF6FF"
    style.stroke: "#1D4ED8"
    style.font-color: "#0F172A"
    style.font-size: 14
    style.border-radius: 8
  }
  external: {
    style.fill: "#F8FAFC"
    style.stroke: "#94A3B8"
    style.stroke-dash: 4
    style.font-color: "#0F172A"
    style.font-size: 14
    style.border-radius: 8
  }
}

flow: {
  label: ""
  grid-rows: 2
  grid-columns: 3
  grid-gap: 65
  style.fill: transparent
  style.stroke-width: 0

  profile: "Worker Profile\n管理员配置" { class: accent }
  snapshot: "Task Snapshot\n创建任务时冻结" { class: node }
  bundle: "Runtime Bundle\n按冻结身份解析" { class: node }
  edit: "后续修改 Worker Profile\n只影响新任务" { class: node }
  no_effect: "现有任务\n沿用各自快照" { class: node }
  task: "Task\n实际执行" { class: node }

  profile -> snapshot
  snapshot -> bundle
  bundle -> task
  profile -> edit
  edit -> no_effect
}
