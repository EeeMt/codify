# 章节：50-delivery（交付）· 从起始分支到需求关闭
# 读者要理解：需求的所有回合都落在同一条工作分支上；提交之后只有一条分岔——
# 建 MR 就先草稿后转正、合并进目标分支，不建 MR 就只推送分支；
# 两条路的终点相同：需求关闭，工作分支按设置保留或删除。
# 渲染：python3 scripts/guide/render-diagrams.py（在仓库根目录执行）

vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: right

classes: {
  node: {
    style.fill: "#FFFFFF"
    style.stroke: "#334155"
    style.stroke-width: 1
    style.font-color: "#0F172A"
    style.font-size: 14
    style.border-radius: 8
  }
  accent: {
    style.fill: "#EFF6FF"
    style.stroke: "#1D4ED8"
    style.font-color: "#0F172A"
    style.font-size: 14
    style.border-radius: 8
  }
  external: {
    style.fill: "#F8FAFC"
    style.stroke: "#94A3B8"
    style.stroke-dash: 4
    style.font-color: "#0F172A"
    style.font-size: 14
    style.border-radius: 8
  }
}

# 两行各四格，横向间距处处一致，没有空单元格。不建 MR 的那条路从工作分支向下
# 离开，在需求关闭处与 MR 那条路重新汇合，两条路共用一个终点。
delivery: {
  label: ""
  grid-rows: 2
  grid-columns: 4
  grid-gap: 24
  style.fill: transparent
  style.stroke-width: 0

  base: "起始分支\n工作从这里开始" { class: node }
  branch: "codify/issue-{id}\n提交都落在这里" { class: accent }
  mr: "Merge Request\n先草稿，后转正" { class: node }
  merged: "合并\n进入合并目标" { class: node }
  nomr: "不创建 MR\n需求上的开关" { class: node }
  direct: "直接推送\n不经过 MR 路径" { class: node }
  closed: "需求关闭\n手动或 Webhook" { class: node }
  cleanup: "分支清理\n删除或保留" { class: node }

  base -> branch
  branch -> mr
  mr -> merged
  merged -> closed
  closed -> cleanup
  branch -> direct
  nomr -> direct
  direct -> closed
}
