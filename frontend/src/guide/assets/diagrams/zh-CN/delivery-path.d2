# 章节：50-delivery（交付）· 从起始分支到需求关闭
# 读者要理解：需求的所有回合都落在同一条工作分支上；提交之后只有一条分岔——
# 建 MR 就先草稿后转正、合并进目标分支，不建 MR 就只推送分支；
# 两条路的终点相同：需求关闭，工作分支按设置保留或删除。
# 渲染：python3 scripts/guide/render-diagrams.py（在仓库根目录执行）

vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: right

classes: {
  node: {
    style.fill: "#FFFFFF"
    style.stroke: "#334155"
    style.stroke-width: 1
    style.font-color: "#0F172A"
    style.font-size: 14
    style.border-radius: 8
  }
  accent: {
    style.fill: "#EFF6FF"
    style.stroke: "#1D4ED8"
    style.font-color: "#0F172A"
    style.font-size: 14
    style.border-radius: 8
  }
  external: {
    style.fill: "#F8FAFC"
    style.stroke: "#94A3B8"
    style.stroke-dash: 4
    style.font-color: "#0F172A"
    style.font-size: 14
    style.border-radius: 8
  }
}

delivery: {
  label: ""
  grid-rows: 3
  grid-columns: 3
  grid-gap: 40
  style.fill: transparent
  style.stroke-width: 0

  base: "起始分支\n拉取代码的基线" { class: node }
  branch: "codify/issue-{id}\n需求级工作分支" { class: accent }
  commits: "提交\n每个回合都推送" { class: node }
  blank_a: " " { style.fill: transparent; style.stroke-width: 0 }
  mr: "Merge Request\n先草稿，后转正" { class: node }
  direct: "直接推送\n不创建 MR" { class: node }
  blank_b: " " { style.fill: transparent; style.stroke-width: 0 }
  merged: "合并\n进入合并目标" { class: node }
  closed: "需求关闭\n分支按设置处理" { class: node }

  base -> branch
  branch -> commits
  commits -> mr
  commits -> direct
  mr -> merged
  merged -> closed
  direct -> closed
}
