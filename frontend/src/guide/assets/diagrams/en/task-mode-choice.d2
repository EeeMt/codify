# Chapter: guide/en/30-create-task.md — "Task modes", "Run now or schedule".
# Reader takeaway: a Task makes two choices in one form — which Task Mode the run
# follows (Implementation modifies and commits, Analysis answers without changing
# files, Freeform lets the Harness decide) and when it enters the queue
# (Execute Now straight away, or Schedule at a future time).
# Render: d2 task-mode-choice.d2 task-mode-choice.svg --pad 36 --theme 0 --layout elk,
# then set width and height on the root <svg> to the viewBox size so the asset also
# renders 1:1 outside the guide's <img>.
# 渲染：python3 scripts/guide/render-diagrams.py（在仓库根目录执行）

vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: right

classes: {
  node: {
    style.fill: "#F7F9FC"
    style.stroke: "#294A6E"
    style.stroke-width: 1
    style.font-color: "#102A43"
    style.font-size: 14
    style.border-radius: 14
  }
  accent: {
    style.fill: "#E8F0FF"
    style.stroke: "#2454A6"
    style.stroke-width: 2
    style.font-color: "#102A43"
    style.font-size: 14
    style.border-radius: 14
  }
  choice: {
    style.fill: "#FFF3D6"
    style.stroke: "#B7791F"
    style.stroke-width: 2
    style.font-color: "#5F370E"
    style.font-size: 14
    style.border-radius: 14
  }
  evidence: {
    style.fill: "#E6F7F2"
    style.stroke: "#187A6F"
    style.stroke-width: 2
    style.font-color: "#123B36"
    style.font-size: 14
    style.border-radius: 14
  }
  external: {
    style.fill: "#F7F9FC"
    style.stroke: "#8EA0B5"
    style.stroke-dash: 4
    style.font-color: "#334E68"
    style.font-size: 14
    style.border-radius: 14
  }
}

# Two choices, two clusters: the Task Mode cluster on the left (the mode node with
# its three options wrapping into the second row, each option adjacent to the node it
# belongs to), the Schedule cluster on the right with its two times.
choice: {
  label: ""
  grid-rows: 2
  grid-columns: 4
  grid-gap: 32
  style.fill: transparent
  style.stroke-width: 0

  mode: "Task Mode\nhow the run works" { class: accent }
  impl: "Implementation\nchanges, then commits" { class: node }
  sched: "Schedule\nwhen it runs" { class: node }
  now: "Execute Now\njoins the queue" { class: node }
  analysis: "Analysis\nanswers only" { class: evidence }
  freeform: "Freeform\nHarness decides" { class: choice }
  at: "Schedule at\na future time" { class: node }
  gap: " " { style.fill: transparent; style.stroke-width: 0 }

  mode -> impl
  mode -> analysis
  mode -> freeform
  sched -> now
  sched -> at
}
