# Chapter: guide/en/70-observability.md — "Dashboard", "Analytics", "Monitor",
# "Schedule overview", "Sessions".
# Reader takeaway: the five pages answer five different questions — Dashboard is my
# own progress, Analytics is trends and cost over a window, Monitor is live
# failures, Schedule Overview is future load, Sessions is which sign-ins are open.
# Render: d2 observability-map.d2 observability-map.svg --pad 36 --theme 0 --layout elk,
# then set width and height on the root <svg> to the viewBox size so the asset also
# renders 1:1 outside the guide's <img>.
# 渲染：python3 scripts/guide/render-diagrams.py（在仓库根目录执行）

vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: right

classes: {
  node: {
    style.fill: "#FFFFFF"
    style.stroke: "#334155"
    style.stroke-width: 1
    style.font-color: "#0F172A"
    style.font-size: 14
    style.border-radius: 8
  }
  accent: {
    style.fill: "#EFF6FF"
    style.stroke: "#1D4ED8"
    style.font-color: "#0F172A"
    style.font-size: 14
    style.border-radius: 8
  }
  external: {
    style.fill: "#F8FAFC"
    style.stroke: "#94A3B8"
    style.stroke-dash: 4
    style.font-color: "#0F172A"
    style.font-size: 14
    style.border-radius: 8
  }
}

pages: {
  label: ""
  grid-rows: 2
  grid-columns: 3
  grid-gap: 45
  style.fill: transparent
  style.stroke-width: 0

  dashboard: "Dashboard\nmy own progress" { class: node }
  analytics: "Analytics\ntrends and cost" { class: node }
  monitor: "Monitor\nlive failures" { class: node }
  schedule: "Schedule Overview\nfuture load" { class: node }
  q: "My question\nwhich page?" { class: accent }
  sessions: "Sessions\ndashboard sign-ins" { class: node }

  q -> dashboard
  q -> analytics
  q -> monitor
  q -> schedule
  q -> sessions
}
