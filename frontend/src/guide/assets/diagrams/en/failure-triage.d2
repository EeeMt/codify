# Chapter: guide/en/90-troubleshooting.md — "Task failed".
# Reader takeaway: when a task fails, read it in one order — the Failure reason on
# the task, then Events, Raw Logs and the Runtime Archive — and recognise the
# message by its shape: a timeout, an exceeded usage limit, a Worker runtime that
# is not available, or a push that was never confirmed.
# Render: d2 failure-triage.d2 failure-triage.svg --pad 36 --theme 0 --layout elk,
# then set width and height on the root <svg> to the viewBox size so the asset also
# renders 1:1 outside the guide's <img>.
# 渲染：python3 scripts/guide/render-diagrams.py（在仓库根目录执行）

vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: right

classes: {
  node: {
    style.fill: "#F7F9FC"
    style.stroke: "#294A6E"
    style.stroke-width: 1
    style.font-color: "#102A43"
    style.font-size: 14
    style.border-radius: 14
  }
  accent: {
    style.fill: "#E8F0FF"
    style.stroke: "#2454A6"
    style.stroke-width: 2
    style.font-color: "#102A43"
    style.font-size: 14
    style.border-radius: 14
  }
  choice: {
    style.fill: "#FFF3D6"
    style.stroke: "#B7791F"
    style.stroke-width: 2
    style.font-color: "#5F370E"
    style.font-size: 14
    style.border-radius: 14
  }
  evidence: {
    style.fill: "#E6F7F2"
    style.stroke: "#187A6F"
    style.stroke-width: 2
    style.font-color: "#123B36"
    style.font-size: 14
    style.border-radius: 14
  }
  danger: {
    style.fill: "#FDEBEC"
    style.stroke: "#B42318"
    style.stroke-width: 2
    style.font-color: "#6B1D1A"
    style.font-size: 14
    style.border-radius: 14
  }
  external: {
    style.fill: "#F7F9FC"
    style.stroke: "#8EA0B5"
    style.stroke-dash: 4
    style.font-color: "#334E68"
    style.font-size: 14
    style.border-radius: 14
  }
}

# The numbered chain is the order to read in; the four unnumbered nodes around the
# Failure reason are the message shapes that appear there, so every one of them
# points at it.
triage: {
  label: ""
  grid-rows: 2
  grid-columns: 4
  grid-gap: 30
  style.fill: transparent
  style.stroke-width: 0

  timeout: "Timeout\nfrozen limit too small" { class: danger }
  error: "1. Failure reason\non the task" { class: accent }
  events: "2. Events\nwhat ran, in order" { class: evidence }
  logs: "3. Raw Logs\ncontainer output" { class: node }
  quota: "Usage limit\nexceeded before start" { class: choice }
  runtime: "Worker runtime\nnot available" { class: danger }
  push: "Push not confirmed\ndelivery failed" { class: choice }
  archive: "4. Runtime Archive\ncomplete evidence" { class: evidence }

  error -> events
  events -> logs
  logs -> archive
  error -> timeout
  error -> quota
  error -> runtime
  error -> push
}
