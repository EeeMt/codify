# Chapter: guide/en/40-run-and-steer.md — "Live process log" and task actions.
# Reader takeaway: observe the current run first, then choose a control that fits
# its outcome; follow-ups continue the Issue while retries preserve the snapshot.
# Render: python3 scripts/guide/render-diagrams.py (from the repository root).

vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: right

classes: {
  node: {
    style.fill: "#FFFFFF"
    style.stroke: "#334155"
    style.stroke-width: 1
    style.font-color: "#0F172A"
    style.font-size: 14
    style.border-radius: 8
  }
  accent: {
    style.fill: "#EFF6FF"
    style.stroke: "#1D4ED8"
    style.font-color: "#0F172A"
    style.font-size: 14
    style.border-radius: 8
  }
}

# Three rows of three cells: the run and the two panels that observe and steer it
# across the top, the outcome in the middle of the second row, and the three
# controls that answer it across the bottom. Centring the outcome keeps all three
# of its arrows short and clear of the cards beside them, and the invisible fillers
# hold the outer cells of that middle row so the outcome lands under the steering
# panel.
flow: {
  label: ""
  grid-rows: 3
  grid-columns: 3
  grid-gap: 42
  style.fill: transparent
  style.stroke-width: 0

  run: "Run\nWorker container" { class: accent }
  observe: "Observe\nEvents, Raw Logs" { class: node }
  guide: "Live steering\nSteer, Follow-up" { class: node }
  gap_a: " " { style.fill: transparent; style.stroke-width: 0 }
  finish: "Finish\nCompleted / Failed / Cancelled" { class: node }
  gap_b: " " { style.fill: transparent; style.stroke-width: 0 }
  append: "Continue\nAppend a Task" { class: node }
  retry: "Recover\nRetry Task" { class: node }
  archive: "Keep evidence\nRuntime Archive" { class: node }

  run -> observe
  observe -> guide
  guide -> finish
  finish -> append
  finish -> retry
  finish -> archive
}
