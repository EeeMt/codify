# Chapter: guide/en/85-admin-governance.md — "Usage management", "Where limits are enforced".
# Reader takeaway: a usage quota counts four dimensions — daily and weekly tokens,
# daily and weekly tasks — and it stops work in two places: at task creation, where
# the request is rejected, and again when the queued task is about to start, where
# the task fails before any work happens.
# Render: d2 quota-gates.d2 quota-gates.svg --pad 36 --theme 0 --layout elk,
# then set width and height on the root <svg> to the viewBox size so the asset also
# renders 1:1 outside the guide's <img>.
# 渲染：python3 scripts/guide/render-diagrams.py（在仓库根目录执行）

vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: right

classes: {
  node: {
    style.fill: "#FFFFFF"
    style.stroke: "#334155"
    style.stroke-width: 1
    style.font-color: "#0F172A"
    style.font-size: 14
    style.border-radius: 8
  }
  accent: {
    style.fill: "#EFF6FF"
    style.stroke: "#1D4ED8"
    style.font-color: "#0F172A"
    style.font-size: 14
    style.border-radius: 8
  }
  external: {
    style.fill: "#F8FAFC"
    style.stroke: "#94A3B8"
    style.stroke-dash: 4
    style.font-color: "#0F172A"
    style.font-size: 14
    style.border-radius: 8
  }
}

gates: {
  label: ""
  grid-rows: 3
  grid-columns: 4
  grid-gap: 40
  style.fill: transparent
  style.stroke-width: 0

  daily_tokens: "Daily tokens\ncurrent day" { class: node }
  weekly_tokens: "Weekly tokens\ncurrent week" { class: node }
  daily_tasks: "Daily tasks\ncurrent day" { class: node }
  gap1: " " { style.fill: transparent; style.stroke-width: 0 }
  weekly_tasks: "Weekly tasks\ncurrent week" { class: node }
  created: "Task created\nfirst check" { class: accent }
  queued: "Task queued\nwaits for capacity" { class: node }
  start: "Execution starts\nfinal check" { class: accent }
  gap2: " " { style.fill: transparent; style.stroke-width: 0 }
  rejected: "Request rejected\nno task created" { class: node }
  gap3: " " { style.fill: transparent; style.stroke-width: 0 }
  failed: "Task fails\nbefore any work" { class: node }

  daily_tokens -> created
  weekly_tokens -> created
  daily_tasks -> created
  weekly_tasks -> created
  created -> queued
  queued -> start
  created -> rejected: "over limit"
  start -> failed: "over limit"
}
