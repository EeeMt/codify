# Chapter: guide/en/80-admin-configuration.md — "Task Snapshot and Runtime Bundle".
# Reader takeaway: a Task does not run the Worker Profile as it looks now —
# creation freezes the profile into a Task Snapshot and resolves a Runtime
# Bundle, so a later profile edit only reaches Tasks created after it.
# Render: d2 profile-to-bundle.d2 profile-to-bundle.svg --pad 36 --theme 0 --layout elk,
# then set width and height on the root <svg> to the viewBox size so the asset also
# renders 1:1 outside the guide's <img>.
# 渲染：python3 scripts/guide/render-diagrams.py（在仓库根目录执行）

vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: right

classes: {
  node: {
    style.fill: "#FFFFFF"
    style.stroke: "#334155"
    style.stroke-width: 1
    style.font-color: "#0F172A"
    style.font-size: 14
    style.border-radius: 8
  }
  accent: {
    style.fill: "#EFF6FF"
    style.stroke: "#1D4ED8"
    style.font-color: "#0F172A"
    style.font-size: 14
    style.border-radius: 8
  }
  external: {
    style.fill: "#F8FAFC"
    style.stroke: "#94A3B8"
    style.stroke-dash: 4
    style.font-color: "#0F172A"
    style.font-size: 14
    style.border-radius: 8
  }
}

flow: {
  label: ""
  grid-rows: 2
  grid-columns: 3
  grid-gap: 65
  style.fill: transparent
  style.stroke-width: 0

  profile: "Worker Profile\nadmin-configured" { class: accent }
  snapshot: "Task snapshot\nfrozen at creation" { class: node }
  bundle: "Runtime Bundle\nresolved by digest" { class: node }
  edit: "Later profile edits\nreach new Tasks only" { class: node }
  no_effect: "Existing Tasks\nkeep their snapshot" { class: node }
  task: "Task\nactual run" { class: node }

  profile -> snapshot
  snapshot -> bundle
  bundle -> task
  profile -> edit
  edit -> no_effect
}
