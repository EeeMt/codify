# Chapter: guide/en/10-quick-start.md — "The issue loop".
# Reader takeaway: creating the Issue happens once and everything after it is a
# repeated turn on that same Issue — create or append a Task, let the turn run in an
# isolated container, review the result, then either start the next turn or merge the
# single Merge Request that closes the Issue.
# Render: d2 issue-loop.d2 issue-loop.svg --pad 36 --theme 0 --layout elk, then set
# width and height on the root <svg> to the viewBox size so the asset also renders
# 1:1 outside the guide's <img>.
# 渲染：python3 scripts/guide/render-diagrams.py（在仓库根目录执行）

vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: right

classes: {
  node: {
    style.fill: "#F7F9FC"
    style.stroke: "#294A6E"
    style.stroke-width: 1
    style.font-color: "#102A43"
    style.font-size: 14
    style.border-radius: 14
  }
  accent: {
    style.fill: "#E8F0FF"
    style.stroke: "#2454A6"
    style.stroke-width: 2
    style.font-color: "#102A43"
    style.font-size: 14
    style.border-radius: 14
  }
  choice: {
    style.fill: "#FFF3D6"
    style.stroke: "#B7791F"
    style.stroke-width: 2
    style.font-color: "#5F370E"
    style.font-size: 14
    style.border-radius: 14
  }
  evidence: {
    style.fill: "#E6F7F2"
    style.stroke: "#187A6F"
    style.stroke-width: 2
    style.font-color: "#123B36"
    style.font-size: 14
    style.border-radius: 14
  }
  external: {
    style.fill: "#F7F9FC"
    style.stroke: "#8EA0B5"
    style.stroke-dash: 4
    style.font-color: "#334E68"
    style.font-size: 14
    style.border-radius: 14
  }
}

# Three rows of three cells keep the canvas close to the width the guide's figure box
# renders at, so the 14px labels lose almost nothing when the SVG is scaled down. The
# two invisible fillers hold the first column of the lower rows open, so `continue_turn`
# sits directly under `task` (a short vertical arrow back into the loop) and the
# closing pair shares the last row.
loop: {
  label: ""
  grid-rows: 3
  grid-columns: 3
  grid-gap: 48
  style.fill: transparent
  style.stroke-width: 0

  # Decision words live inside the branch cards instead of on edges. This keeps
  # arrows clear and prevents labels from sitting on card borders.
  issue: "Create the Issue once\nworkspace, session, branch" { class: accent }
  task: "Create or append a Task\nfor the next turn" { class: node }
  run: "Run the turn\nin an isolated container" { class: node }
  gap_a: " " { style.fill: transparent; style.stroke-width: 0 }
  continue_turn: "Continue the loop\nappend a Task" { class: accent }
  review: "Review the result\nnext turn or MR" { class: choice }
  gap_b: " " { style.fill: transparent; style.stroke-width: 0 }
  mr: "When satisfied\nmerge the one MR" { class: evidence }
  closed: "Issue closes\nMR merged" { class: evidence }

  issue -> task
  task -> run
  run -> review
  review -> continue_turn
  continue_turn -> task
  review -> mr
  mr -> closed
}
