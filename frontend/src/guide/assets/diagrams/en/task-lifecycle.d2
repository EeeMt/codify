# Chapter: guide/en/40-run-and-steer.md — "Task lifecycle".
# Reader takeaway: the states a Task moves through, which transitions happen on
# their own, from which states you can cancel it, and that a terminal state can
# be corrected by hand.

vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: right

classes: {
  node: {
    style.fill: "#FFFFFF"
    style.stroke: "#334155"
    style.stroke-width: 1
    style.font-color: "#0F172A"
    style.font-size: 14
    style.border-radius: 8
  }
  accent: {
    style.fill: "#EFF6FF"
    style.stroke: "#1D4ED8"
    style.font-color: "#0F172A"
    style.font-size: 14
    style.border-radius: 8
  }
  external: {
    style.fill: "#F8FAFC"
    style.stroke: "#94A3B8"
    style.stroke-dash: 4
    style.font-color: "#0F172A"
    style.font-size: 14
    style.border-radius: 8
  }
}

states: {
  label: ""
  grid-rows: 2
  grid-columns: 3
  grid-gap: 90
  style.fill: transparent
  style.stroke-width: 0

  pending: "Pending\nnot yet eligible" { class: node }
  queued: "Queued\nwaiting for a slot" { class: node }
  running: "Running\nexecuting now" { class: accent }
  completed: "Completed\ndelivered" { class: node }
  failed: "Failed\nerror or timeout" { class: node }
  cancelled: "Cancelled\nstopped by you" { class: node }

  pending -> queued: "queued"
  queued -> running: "starts"
  running -> completed: "delivered"
  running -> failed: "failed"
  running -> cancelled: "cancel"
  pending -> cancelled
  queued -> cancelled
  completed <-> failed: "manual override"
}
