# Chapter: guide/en/40-run-and-steer.md — "Task lifecycle".
# Reader takeaway: the states a Task moves through, which transitions happen on
# their own, from which states you can cancel it, and that a terminal state can
# be corrected by hand.
# Render: d2 task-lifecycle.d2 task-lifecycle.svg --pad 36 --theme 0 --layout elk,
# then set width and height on the root <svg> to the viewBox size so the asset also
# renders 1:1 outside the guide's <img>.
# 渲染：python3 scripts/guide/render-diagrams.py（在仓库根目录执行）

vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: right

classes: {
  node: {
    style.fill: "#FFFFFF"
    style.stroke: "#334155"
    style.stroke-width: 1
    style.font-color: "#0F172A"
    style.font-size: 14
    style.border-radius: 8
  }
  accent: {
    style.fill: "#EFF6FF"
    style.stroke: "#1D4ED8"
    style.font-color: "#0F172A"
    style.font-size: 14
    style.border-radius: 8
  }
  external: {
    style.fill: "#F8FAFC"
    style.stroke: "#94A3B8"
    style.stroke-dash: 4
    style.font-color: "#0F172A"
    style.font-size: 14
    style.border-radius: 8
  }
}

states: {
  label: ""
  grid-rows: 2
  grid-columns: 3
  grid-gap: 90
  style.fill: transparent
  style.stroke-width: 0

  pending: "Pending\nwaiting to run" { class: node }
  queued: "Queued\nwaiting for a free slot" { class: node }
  running: "Running\nexecuting now" { class: accent }
  completed: "Completed\nrun finished" { class: node }
  failed: "Failed\nerror or timeout" { class: node }
  cancelled: "Cancelled\nstopped by you" { class: node }

  # Running's three outcomes are already named by their target states, so those
  # transitions carry no label: the long Pending/Queued -> Cancelled diagonals
  # cross that band and would route straight through the label text. The correction
  # between the two terminal states runs one way only — `failed -> completed` — and
  # its label is split over two lines so it fits the column gap instead of
  # overhanging the cards on either side.
  pending -> queued
  queued -> running: "starts"
  running -> completed
  running -> failed
  running -> cancelled
  pending -> cancelled
  queued -> cancelled
  failed -> completed: "Manual\nOverride"
}
