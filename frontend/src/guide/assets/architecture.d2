# Codify 系统架构
# d2 frontend/src/guide/assets/architecture.d2 frontend/src/guide/assets/architecture.svg --pad 24 --theme 0 --layout elk
#
# Rendering constraints, because this diagram is shown inline in the guide
# column rather than opened on its own:
#   - vertical flow (elk honours `direction: down`; dagre silently ignores it),
#     so the natural width stays under the ~860px column and the 14px labels are
#     never scaled down. Uniform SVG scaling makes a bigger font pointless, so
#     the only lever that matters is fewer, shorter characters per line.
#   - forward flow only. Return paths (SSE to the browser, GitLab webhooks back
#     into the backend) are deliberately not drawn: as full-height back edges
#     they converged on the same node stubs and made the diagram harder to read,
#     while telling the reader nothing the guide prose does not. They are
#     explained in the surrounding section instead.
#   - one edge per real channel. The two edges into PostgreSQL are drawn with
#     different stroke styles because they share a lane and would otherwise be
#     untraceable.
#   - node labels are technical nouns that read the same in both guide locales.
#     No emoji, no per-box fact lists, no colour-coded tiers.
#
# Grounded in (see the guide's surrounding section for the prose):
#   deploy/docker-compose.yml            three long-lived services from two
#                                       images (nginx, backend, scheduler) plus
#                                       postgres; the scheduler owns migrations
#   deploy/nginx/default.conf           static SPA + /api reverse proxy
#   backend/app/scheduler_service.py    the scheduler is a separate process
#   backend/app/scheduler.py            poll, per-Issue lock, CAS claim
#   backend/app/core/worker_task_lifecycle.py
#                                       container created over the Docker API on
#                                       the daemon pinned by the task snapshot
#   backend/app/core/worker_event_projector.py
#                                       events and logs are pulled back into the
#                                       database, not pushed by the container
#   backend/app/core/worker_gitlab.py   Merge Request lifecycle via the GitLab API
#   deploy/worker-entrypoint/git-delivery.sh
#                                       clone, commit and push happen in the
#                                       container

vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: down

classes: {
  svc: {
    style.fill: "#FFFFFF"
    style.stroke: "#334155"
    style.stroke-width: 1
    style.font-color: "#0F172A"
    style.font-size: 14
    style.border-radius: 8
  }
  store: {
    style.fill: "#1D4ED8"
    style.stroke: "#1D4ED8"
    style.font-color: "#FFFFFF"
    style.font-size: 14
    style.border-radius: 8
  }
  exec: {
    style.fill: "#EFF6FF"
    style.stroke: "#1D4ED8"
    style.font-color: "#0F172A"
    style.font-size: 14
    style.border-radius: 8
  }
  ext: {
    style.fill: "#F8FAFC"
    style.stroke: "#94A3B8"
    style.stroke-dash: 4
    style.font-color: "#0F172A"
    style.font-size: 14
    style.border-radius: 8
  }
}

browser: "Browser · SPA" { class: svc }
nginx: "nginx\nSPA + /api" { class: svc }
api: "backend\nFastAPI · REST" { class: svc }
db: "PostgreSQL\nauthoritative state" { class: store }
sched: "scheduler\norchestration" { class: svc }
container: "Worker container\nsnapshot + bundle" { class: exec }
harness: "Harness\nclaude · codex\nopencode · pi" { class: exec }
gitlab: "GitLab\nrepo · branch" { class: ext }
model: "Model endpoint" { class: ext }

browser -> nginx: "HTTPS"
nginx -> api: "/api"
api -> db: "tasks · config"
sched -> db: "poll · claim" { style.stroke-dash: 4 }
sched -> container: "Docker API"
container -> harness: "launch"
harness -> model: "model calls"
container -> gitlab: "clone · push"
sched -> gitlab: "Merge Request"
