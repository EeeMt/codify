# GitLab Configuration
GITLAB_URL=https://gitlab.example.com
GITLAB_BOT_TOKEN=glpat-your-token-here

# Claude CLI (passed to Worker container)
ANTHROPIC_BASE_URL=http://host.docker.internal:11434/v1
ANTHROPIC_API_KEY=your-api-key
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://codify:codify_password@postgres:5432/codify

# Docker Engine HTTP API (TLS)
DOCKER_HOST=tcp://docker.example.com:2376
DOCKER_TLS_CA=/path/to/ca.pem
DOCKER_TLS_CERT=/path/to/cert.pem
DOCKER_TLS_KEY=/path/to/key.pem

# Custom CA Certificate (optional)
# Path to a PEM CA bundle for verifying HTTPS connections to GitLab, Mattermost,
# Anthropic API, etc. Required when those services use a self-signed or internal CA.
# In Docker deployments, mount the cert file and point this to the container path.
# Example: CUSTOM_CA_BUNDLE=/certs/ca.crt
# CUSTOM_CA_BUNDLE=

# Application
# SESSION_SECRET signs dashboard session tokens. CONFIG_ENCRYPTION_KEY encrypts
# secret values persisted through the Config page, and falls back to
# SESSION_SECRET when it is empty.
SESSION_SECRET=your-session-secret-change-in-production
CONFIG_ENCRYPTION_KEY=your-config-encryption-key-change-in-production
LOG_LEVEL=INFO
SQLALCHEMY_ECHO=false    # Set true to log all SQL queries (very noisy, use for debugging only)
WORKER_IMAGE=codify-worker/java21-maven:2026.07

# Scheduler Configuration (P1)
MAX_CONCURRENCY=3
TASK_TIMEOUT_PEAK_START=09:00
TASK_TIMEOUT_PEAK_END=18:00
TASK_TIMEOUT_PEAK_SECONDS=1800
TASK_TIMEOUT_OFF_PEAK_SECONDS=3600
SCHEDULER_INTERVAL=5
DEFAULT_TARGET_BRANCH=main
MAX_RETRIES=0
RETRY_DELAY=60

# Alert Configuration
ALERT_ON_FAILURE=false
ALERT_WEBHOOK_URL=
